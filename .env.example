# ---------------------------------------------------------------- browser (public)
# Everything prefixed with VITE_ is shipped to the browser. Never put secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Online payments are optional: the pay buttons appear once the matching IDs are set.
# Payme Business web cash desk ("Merchant ID" / "id кассы")
VITE_PAYME_MERCHANT_ID=
# https://checkout.paycom.uz (default, production) or https://test.paycom.uz (sandbox)
VITE_PAYME_CHECKOUT_URL=
# Click service (both IDs are shown in the Click merchant cabinet)
VITE_CLICK_SERVICE_ID=
VITE_CLICK_MERCHANT_ID=

# ---------------------------------------------------------------- server only
# Set these as secret environment variables in your host (Vercel, Lovable, ...), never in git
# and never with a VITE_ prefix.
# Service-role key: lets the payment endpoints run the payment state machine.
SUPABASE_SERVICE_ROLE_KEY=
# Payme cash desk "Key" (or the sandbox TEST_KEY while testing)
PAYME_KEY=
# Click secret key and service ID (same service ID as VITE_CLICK_SERVICE_ID)
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
# Protects the Vercel Cron endpoint that expires subscriptions and sends signed seller webhooks.
CRON_SECRET=
# Fiscal receipt line that Payme requests for fiscalised cash desks (all three or none)
PAYME_IKPU=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=
